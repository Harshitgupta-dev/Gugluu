# === Premake & Build Outputs ===
# Ignore the generated binary and intermediate object directories
Bin/
Bin-Int/

# === IDE & Compiler Artifacts (Windows/MSVC) ===
# Ignore Visual Studio solution and project files generated by Premake
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Ignore Visual Studio cache and user-specific folders
.vs/
*.suo
*.db
*.opendb

# Ignore generated runtime binaries and debug symbols.
*.dll
*.pdb

# === Dependencies ===
# Restore all model and ONNX Runtime assets with scripts/setup_dependencies.py.
Gugluu/Vendor/
Gugluu/vendor/

# Keep local index caches out of source control.
*.gdata
